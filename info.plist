				<string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
SECRET_TEXT="$1"

if [ -z "$SECRET_TEXT" ]; then
  echo "No text received"
  exit 0
fi

# Stash via a private one-shot file, not the clipboard: Alfred's own
# selection-capture (Hotkey "Selection in macOS" / Universal Action) restores
# the clipboard to its pre-selection value shortly after handing us the text,
# which races with the user typing the item name and can overwrite SECRET_TEXT
# before the iop keyword step reads it back.
PENDING_FILE="$TMPDIR/alfred-1password-pending-secret"
umask 077
printf '%s' "$SECRET_TEXT" &gt; "$PENDING_FILE"

# Also copy to clipboard for visibility/manual fallback; harmless if restored.
printf '%s' "$SECRET_TEXT" | pbcopy

osascript -e 'tell application id "com.runningwithcrayons.Alfred" to search "iop "'

echo "Ready — type a name after iop and press Enter"</string>
