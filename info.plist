				<string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
TITLE="$1"

if [ -z "$TITLE" ]; then
  echo "Usage: iop &lt;item name&gt; (copy the secret first)"
  exit 0
fi

PENDING_FILE="$TMPDIR/alfred-1password-pending-secret"
SECRET_TEXT=""

if [ -f "$PENDING_FILE" ]; then
  # Only trust it for 2 minutes, so a stale forgotten run never gets reused.
  age=$(( $(date +%s) - $(stat -f %m "$PENDING_FILE" 2&gt;/dev/null || echo 0) ))
  if [ "$age" -le 120 ]; then
    SECRET_TEXT="$(cat "$PENDING_FILE")"
  fi
  rm -f "$PENDING_FILE"
fi

if [ -z "$SECRET_TEXT" ]; then
  SECRET_TEXT="$(pbpaste)"
fi

if [ -z "$SECRET_TEXT" ]; then
  echo "Clipboard is empty — copy the secret first"
  exit 0
fi

RESULT_JSON=$(op item create \
  --category="API Credential" \
  --title="$TITLE" \
  "credential=$SECRET_TEXT" \
  --format json &lt; /dev/null 2&gt;/dev/null)

if [ $? -eq 0 ]; then
  pbcopy &lt; /dev/null
  DB_PATH="$HOME/Library/Application Support/Alfred/Databases/clipboard.alfdb"
  if [ -f "$DB_PATH" ]; then
    sqlite3 "$DB_PATH" "DELETE FROM clipboard WHERE item = '$(printf "%s" "$SECRET_TEXT" | sed "s/'/''/g")';"
  fi

  REF=$(printf '%s' "$RESULT_JSON" | jq -r '.fields[] | select(.id=="credential") | .reference')
  printf '%s' "$REF" | pbcopy

  echo "Saved as \"$TITLE\" — reference copied, wiped from Alfred"
else
  echo "Failed to save to 1Password"
fi</string>
